# 环境变量示例 —— 仅示例，不得填入真实密钥。
# 真实 .env 已被 .gitignore 排除，绝不会进入仓库。

# 运行环境：development | test | production
STUDY_PLATFORM_ENV=development

# 开发存储（SQLite）。生产适配器为 PostgreSQL + RLS，本版未实现，见 README。
STUDY_PLATFORM_DB_PATH=var/platform.db

# 审计 sink 目录。独立于主库，应用只追加、无删除权。
STUDY_PLATFORM_AUDIT_DIR=var/audit

# capability token 签名密钥。
# 开发用占位值；生产必须来自 KMS / Secret Manager，并与其他密钥分离。
STUDY_PLATFORM_TOKEN_SECRET=dev-only-placeholder-change-me
