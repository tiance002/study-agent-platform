# 环境变量示例 —— 仅示例，不得填入真实密钥。
# 真实 .env 已被 .gitignore 排除，绝不会进入仓库。
#
# 本文件只列【代码真实读取】的变量（grep STUDY_PLATFORM_ 可核对）。
# 早期版本里的 STUDY_PLATFORM_DB_URL / DB_PATH / AUDIT_DIR 是幽灵配置：
# 代码从未读取过它们，照着配置永远不会生效。已删除。

# ===== 数据库 =====
# 应用连接串：必须指向 study_app 角色（NOSUPERUSER + NOBYPASSRLS）。
# 与迁移 DSN 分离是安全边界：迁移角色有 DDL 权限，应用角色绝不能有：
# 有 DDL 就能 DISABLE ROW LEVEL SECURITY，隔离会退化成"应用自觉"。
STUDY_PLATFORM_DSN=postgresql://study_app@127.0.0.1:5432/study_platform

# worker 凭据连接串：必须指向 study_worker 角色（与应用角色**不同**）。
# 队列的跨租户可见性只授予该角色（0008 迁移）：
# 自定义变量（如 app.worker_id）不是凭据 —— 能自己设的东西不是边界。
STUDY_PLATFORM_WORKER_DSN=postgresql://study_worker@127.0.0.1:5432/study_platform

# Alembic 迁移连接串：需要 DDL 权限（本地开发用 postgres 超级用户）。
STUDY_PLATFORM_MIGRATION_DSN=postgresql+psycopg://postgres@127.0.0.1:5432/study_platform

# ===== 密钥（生产必须由 KMS / Secret Manager 提供，且互相分离）=====
# 会话令牌签名密钥：客户端无法伪造身份，靠的就是它。
STUDY_PLATFORM_SESSION_SECRET=dev-only-session-secret-change-me

# cookie 会话签名密钥。生产必须与会话令牌密钥**分离**（泄露隔离）；
# 本地开发缺省复用 SESSION_SECRET，少一个要配的变量。
STUDY_PLATFORM_COOKIE_SECRET=dev-only-cookie-secret-change-me

# 生产置 1：cookie 加 Secure 标记（HTTPS-only）。
# 本机开发与测试保持空 —— TestClient 走 http，Secure cookie 不会被回传。
STUDY_PLATFORM_COOKIE_SECURE=

# capability token 签名密钥
STUDY_PLATFORM_TOKEN_SECRET=dev-only-placeholder-change-me

# ===== 模型教学（第五轮）=====
# provider 开关（闭集）：disabled / scripted / openai。
# 没有凭据时保持 disabled：教学端点会明确报"功能未启用"，
# 绝不静默退回模拟器假装可用。
STUDY_PLATFORM_TEACHING_PROVIDER=disabled

# 批准的模型标识（服务端决策，客户端无权选择）。启用 openai 时必填。
STUDY_PLATFORM_TEACHING_MODEL=

# provider 凭据：只由服务端适配器从环境读取，不进仓库/日志/数据库。
STUDY_PLATFORM_TEACHING_API_KEY=
# 可选：默认使用 https://api.openai.com/v1；兼容网关请显式填写完整 /v1 基址。
STUDY_PLATFORM_TEACHING_BASE_URL=https://api.openai.com/v1

# 单次请求的输入/输出 token 上限与单项目预算（微单位，1 micro = 计费货币的 1e-6）。
STUDY_PLATFORM_TEACHING_MAX_INPUT_TOKENS=8000
STUDY_PLATFORM_TEACHING_MAX_OUTPUT_TOKENS=2000
STUDY_PLATFORM_TEACHING_PROJECT_BUDGET_MICRO=5000000
