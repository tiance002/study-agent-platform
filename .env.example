# 环境变量示例 —— 仅示例，不得填入真实密钥。
# 真实 .env 已被 .gitignore 排除，绝不会进入仓库。

# 运行环境：development | test | production
STUDY_PLATFORM_ENV=development

# ===== 数据库 =====
# PostgreSQL 16.4 已装在本机 E 盘（用 scripts/pg_start.cmd 启动）。
# ⚠️ 应用当前仍使用**进程内适配器**，尚未连接这个数据库 —— 见 README 的「未实现项」。
STUDY_PLATFORM_DB_URL=postgresql://study_app:dev-only-app-password@127.0.0.1:5432/study_platform

# 进程内适配器的可选落盘位置
STUDY_PLATFORM_DB_PATH=var/platform.db

# ===== 密钥（生产必须由 KMS / Secret Manager 提供，且互相分离）=====
# 会话令牌签名密钥：客户端无法伪造身份，靠的就是它。
STUDY_PLATFORM_SESSION_SECRET=dev-only-session-secret-change-me

# capability token 签名密钥
STUDY_PLATFORM_TOKEN_SECRET=dev-only-placeholder-change-me

# ===== 审计 sink =====
# 独立于主库；应用只追加，没有删除接口。
STUDY_PLATFORM_AUDIT_DIR=var/audit
