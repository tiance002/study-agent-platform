# Copy to /etc/study-plan/provider.env, set owner root:studyplan and mode 640,
# then fill the API key. Never commit the populated file.
# This adapter uses the provider's stateless Responses API.
STUDY_PLATFORM_TEACHING_PROVIDER=openai
STUDY_PLATFORM_TEACHING_MODEL=deepseek-flash
STUDY_PLATFORM_TEACHING_BASE_URL=https://api.deepseek.com
STUDY_PLATFORM_TEACHING_API_KEY=PASTE_DEEPSEEK_API_KEY_HERE
